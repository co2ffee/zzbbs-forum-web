# 用户端 SPA 挂在 / ；后端接口、管理端、WebSocket、第三方登录回调仍然转给 Java（8089）
# 加到现有 443 的 server { } 里，替换原来的 `location / { proxy_pass http://localhost:8089/; }`
# 原有的 `location /api/upload { ... }`（带大小/超时限制的那段）要保留，并且必须改成 `location ^~ /api/upload { ... }`：
# 普通前缀 location 选出后 nginx 还会检查正则，正则匹配上就用正则，不加 ^~ 会被下面的 ^/(api|...) 抢走。

# 1) 用户端静态文件，SPA 路由回退到 index.html
location / {
    root /home/pybbs/forum-ui;
    try_files $uri $uri/ /index.html;
    # index.html（以及所有走 try_files 回退到它的页面路由）每次都向服务器确认有没有更新，
    # 否则浏览器会按 Last-Modified 启发式缓存，部署新版后老用户还在用旧的 JS
    add_header Cache-Control "no-cache";
}

# 带 hash 的静态资源：文件名随内容变化，可以放心长期缓存
# （比 location / 更具体，会优先匹配；add_header 在 location 里会覆盖外层的设置，所以这里单独写）
location /assets/ {
    root /home/pybbs/forum-ui;
    add_header Cache-Control "public, max-age=31536000, immutable";
}

# 2) 转给后端的路径（不要被 SPA 吞掉）
# 注意：/active（邮箱激活链接）由用户端处理，不要转给后端
location ~ ^/(api|common|static|oauth|admin|adminlogin|bot)(/|$) {
    proxy_pass http://localhost:8089;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# 3) WebSocket 实时通知
location /websocket {
    proxy_pass http://localhost:8089/websocket;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
}

# 4) 老的后台页面地址跳到管理端 SPA（浏览器直接访问时 Accept 含 text/html；SPA 自己的接口请求不受影响）
# /adminlogin 由后端自己 302 到 /admin-ui/login，不需要在这里处理
location = /admin {
    if ($http_accept ~* "text/html") { return 301 /admin-ui/; }
    proxy_pass http://localhost:8089;
}
location = /admin/index {
    if ($http_accept ~* "text/html") { return 301 /admin-ui/; }
    proxy_pass http://localhost:8089;
}

# 5) 管理端 SPA（见 zzbbs-admin-web）
# location /admin-ui/ { alias /home/pybbs/admin-ui/; try_files $uri $uri/ /admin-ui/index.html; }
# 管理端 location 用 ^~ 前缀匹配，保证优先于任何正则（第 2 段的 admin(/|$) 本来也不会匹配 /admin-ui/）：
# location ^~ /admin-ui/ { alias /home/pybbs/admin-ui/; try_files $uri $uri/ /admin-ui/index.html; add_header Cache-Control "no-cache"; }
# location ^~ /admin-ui/assets/ { alias /home/pybbs/admin-ui/assets/; add_header Cache-Control "public, max-age=31536000, immutable"; }
